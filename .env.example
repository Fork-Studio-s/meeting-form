# The Gmail account that sends and receives form notifications
GMAIL_USER=info.gabelnstudio@gmail.com

# Generate at https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be turned on for GMAIL_USER first.
GMAIL_APP_PASSWORD=your16characterapppassword
 
# Firebase Cloud Firestore Credentials (from service account JSON)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

